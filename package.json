{
  "name": "better-gh-md",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "dev:extension": "pnpm --filter @better-gh-md/extension dev",
    "build:extension": "pnpm --filter @better-gh-md/extension build",
    "dev:playground": "pnpm --filter @better-gh-md/playground dev",
    "test:e2e": "pnpm --filter @better-gh-md/playground test:e2e",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "zip": "pnpm --filter @better-gh-md/extension zip"
  },
  "packageManager": "pnpm@9.15.0",
  "devDependencies": {
    "@biomejs/biome": "^2.5.14"
  }
}
