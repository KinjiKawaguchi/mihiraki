{
  "name": "mihiraki",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "dev:extension": "pnpm --filter @mihiraki/extension dev",
    "build:extension": "pnpm --filter @mihiraki/extension build",
    "dev:playground": "pnpm --filter @mihiraki/playground dev",
    "test:e2e": "pnpm --filter @mihiraki/playground test:e2e",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "zip": "pnpm --filter @mihiraki/extension zip"
  },
  "packageManager": "pnpm@10.34.5",
  "devDependencies": {
    "@biomejs/biome": "^2.5.14"
  }
}
